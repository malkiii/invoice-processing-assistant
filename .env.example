# Copy to .env and fill in. `docker compose up` reads this file.

# --- Required secrets ---
# Signs sessions and tokens. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Encrypts Provider Connection keys at rest (AES-256-GCM, ADR 0003). 32 bytes as 64 hex chars.
# Generate with: openssl rand -hex 32
# Losing it means every User must re-enter their provider keys.
ENCRYPTION_KEY=

# Public URL of the app (used for auth callbacks and email links).
BETTER_AUTH_URL=http://localhost:3000
APP_PORT=3000

# --- Database (the Compose postgres service) ---
POSTGRES_USER=invoices
POSTGRES_PASSWORD=invoices
POSTGRES_DB=invoices
# Only needed when running outside Compose (pnpm dev, pnpm db:migrate, drizzle-kit):
DATABASE_URL=postgres://invoices:invoices@localhost:5432/invoices

# --- Object storage (ADR 0002). Defaults target the Compose minio service. ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=documents
S3_REGION=us-east-1
# S3_ENDPOINT=http://minio:9000
# Endpoint browsers use for presigned URLs:
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# --- Email (optional). Without SMTP_HOST, email verification is skipped and a warning is logged. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Invoice Processing Assistant <no-reply@example.com>"

# --- OAuth sign-in (optional). Each provider is enabled when both values are set. ---
# Callback URLs: ${BETTER_AUTH_URL}/api/auth/callback/google and .../github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Ollama (optional, `docker compose --profile ollama up`) ---
# OLLAMA_BASE_URL=http://ollama:11434
