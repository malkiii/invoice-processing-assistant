{
  "name": "invoice-processing-assistant",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.21"
  },
  "scripts": {
    "dev": "nuxt dev",
    "dev:worker": "tsx watch server/worker.ts",
    "build": "nuxt build && pnpm build:worker",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "node .output/migrate/index.mjs && node .output/server/index.mjs",
    "start:worker": "node .output/worker/index.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/migrate.ts",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.105",
    "@ai-sdk/google": "^4.0.121",
    "@ai-sdk/mistral": "^4.0.87",
    "@ai-sdk/openai": "^4.0.118",
    "@ai-sdk/openai-compatible": "^3.0.92",
    "@aws-sdk/client-s3": "^3.1170.0",
    "@aws-sdk/s3-request-presigner": "^3.1170.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lucide/vue": "^1.74.0",
    "@mozilla/readability": "^0.6.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vueuse/core": "^15.0.0",
    "ai": "^7.0.173",
    "better-auth": "^1.7.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "file-type": "^22.3.0",
    "gsap": "^3.15.1",
    "ipaddr.js": "^2.5.0",
    "jszip": "^3.10.2",
    "linkedom": "^0.18.15",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.6.0",
    "nuxt": "^4.6.4",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^2.2.1",
    "uqr": "^0.1.3",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "22",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "shadcn-nuxt": "^2.9.0",
    "testcontainers": "^11.14.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  }
}
